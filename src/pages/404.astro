---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandMark from "../components/BrandMark.astro";
---

<BaseLayout
  title="Página no encontrada | Il Figlio"
  description="La página que buscás no existe."
  bodyClass="not-found-body"
  robots="noindex, follow"
>
  <main id="main-content" class="not-found-page">
    <header class="not-found-header" aria-label="Encabezado principal">
      <a class="site-header__brand" href="/" aria-label="Il Figlio, volver al inicio">
        <BrandMark class="site-header__mark" decorative={true} size={1080} />
        <span class="site-header__name">IL FIGLIO</span>
      </a>
      <span class="not-found-header__location">Lanús Oeste</span>
    </header>

    <section class="not-found" aria-labelledby="not-found-title">
      <div class="not-found__number" aria-hidden="true">
        <span>4</span>
        <BrandMark class="not-found__mark" decorative={true} size={256} />
        <span>4</span>
      </div>

      <div class="not-found__copy">
        <p class="section-eyebrow">Error 404</p>
        <h1 id="not-found-title">Esta página no está en la carta.</h1>
        <p class="not-found__message">
          El enlace puede haber cambiado, pero la pizza sigue acá.
        </p>
        <a class="button button--primary" href="/carta/">Ver la carta</a>
      </div>
    </section>

    <footer class="not-found-footer">
      <p>Pizza al molde</p>
      <p>Hecha en el barrio</p>
    </footer>
  </main>
</BaseLayout>
