---
import type { MenuCategoryDefinition, MenuItem } from "../types/menu";
import { priceKindLabels } from "../domain/menu-config";
import MenuItemRow from "./MenuItemRow.astro";

interface Props {
  category: MenuCategoryDefinition;
  items: readonly MenuItem[];
  sectionNumber: number;
}

const { category, items, sectionNumber } = Astro.props;
---

<section class="menu-section" id={category.id} aria-labelledby={`${category.id}-title`}>
  <header class="menu-section__header">
    <p class="menu-section__number" aria-hidden="true">
      {String(sectionNumber).padStart(2, "0")}
    </p>
    <h2 class="menu-section__title" id={`${category.id}-title`}>{category.name}</h2>
    <div class="menu-section__price-headings price-figures" aria-label={`Tipos de precio de ${category.name}`}>
      {category.allowedPriceKinds.map((kind) => (
        <span class="menu-section__price-heading">{priceKindLabels[kind]}</span>
      ))}
    </div>
  </header>

  <div class="menu-section__items">
    {items.map((item) => <MenuItemRow item={item} />)}
  </div>
</section>
