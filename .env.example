# Data source used by the Astro build: "fixture" or "supabase".
# Fixture builds are only for local development and CI.
MENU_DATA_SOURCE=fixture
ALLOW_FIXTURE_BUILD=true

# Public browser/build values. They are safe to expose, but still environment-specific.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
PUBLIC_SITE_URL=http://localhost:4321

# Build-time only. Never prefix this variable with PUBLIC_.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Privileged read-only audit connection. Keep real values local and private.
SUPABASE_AUDIT_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Configure these only as Supabase Edge Function secrets, never in Vercel/client env.
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
# PUBLISH_ALLOWED_ORIGINS=http://localhost:4321
# DEPLOY_HOOK_MODE=test
# DEPLOY_HOOK_TIMEOUT_MS=10000
# PUBLISH_COOLDOWN_SECONDS=60
