# Data source used by the Astro build: "fixture" or "google_snapshot".
# Fixture builds are only for local development and CI.
MENU_DATA_SOURCE=fixture
ALLOW_FIXTURE_BUILD=true

# Build-time source served by the read-only Apps Script web app.
# It is intentionally never requested by the browser.
MENU_SNAPSHOT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec

# Canonical site URL used by Astro metadata.
PUBLIC_SITE_URL=http://localhost:4321
